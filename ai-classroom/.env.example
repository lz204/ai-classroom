# ============ LLM 配置 ============
# 阿里百炼（DashScope）OpenAI 兼容模式：https://help.aliyun.com/zh/model-studio/
# 注意：真实 Key 请填到项目根目录 .env（已被 .gitignore 忽略），勿填写在本模板中
LLM_API_KEY=
# 百炼 OpenAI 兼容端点
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼模型（可按需换 qwen-max / qwen-turbo / qwen-flash）
LLM_MODEL=qwen-plus

# ============ 嵌入与向量检索 ============
EMBEDDING_MODEL=BAAI/bge-large-zh
# 重排模型（可选）：未缓存时自动跳过重排
RERANKER_MODEL=BAAI/bge-reranker-large
# 向量索引路径（注意：必须为纯英文路径！faiss 的 C 层读写不支持中文目录）
VECTOR_INDEX_PATH=E:\ai_classroom_index
# HuggingFace 下载端点（国内网络加速，可选）
HF_ENDPOINT=https://hf-mirror.com

# ============ 服务与存储 ============
# WebSocket 断线重传缓冲 / 会话元数据 / 学情档案：配置则用 Redis，留空则使用进程内存储
# 注意：本机未启动 Redis 时请保持为空，否则相关读写会尝试连接 Redis
REDIS_URL=
# 后端服务端口
BACKEND_PORT=8000
# 会话 / 消息缓冲 / 学情档案在存储中的 TTL（秒）
CLASSROOM_TTL=3600

# ============ 课堂行为 ============
# 学生性格与数量（逗号分隔），以及分组数（性格互补分组研讨）
STUDENT_PERSONALITIES=introvert,active,expert,follower
STUDENT_GROUP_COUNT=2
# 单个教学环节超时（秒）：超时由管理员 Agent 收束
STAGE_TIMEOUT_SECONDS=300
# 整堂课超时（秒）
CLASS_TIMEOUT_SECONDS=1800
# 消息流式分片大小（字符）与片间延迟（秒），前端打字机效果
STREAM_CHUNK_SIZE=12
STREAM_INTERVAL_SECONDS=0.02
