# ============ LLM 配置 ============
# 阿里百炼（DashScope）OpenAI 兼容模式：https://help.aliyun.com/zh/model-studio/
# 注意：真实 Key 请填到项目根目录 .env（已被 .gitignore 忽略），勿填写在本模板中
LLM_API_KEY=
# 百炼 OpenAI 兼容端点
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼模型（可按需换 qwen-max / qwen-turbo / qwen-flash）
LLM_MODEL=qwen-plus

# ============ 嵌入与向量检索 ============
EMBEDDING_MODEL=BAAI/bge-large-zh
# 重排模型（可选）：未缓存时自动跳过重排
RERANKER_MODEL=BAAI/bge-reranker-large
# 向量索引路径（注意：必须为纯英文路径！faiss 的 C 层读写不支持中文目录）
VECTOR_INDEX_PATH=E:\ai_classroom_index
# HuggingFace 下载端点（国内网络加速，可选）
HF_ENDPOINT=https://hf-mirror.com

# ============ 服务与存储 ============
# WebSocket 断线重传缓冲：配置则用 Redis，留空则使用进程内缓冲
# 注意：本机未启动 Redis 时请保持为空，否则断线重传会尝试连接 Redis
REDIS_URL=
# 后端服务端口
BACKEND_PORT=8000
